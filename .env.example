# Copiez ce fichier vers .env (jamais versionné) puis renseignez les valeurs.
# Lecture des variables : python-decouple (.env en local, variables réelles en production).

# --- Profil de fonctionnement ------------------------------------------------
# True  → développement : SQLite (db.sqlite3), statiques servis par Django
# False → production    : PostgreSQL (POSTGRES_*), manifest statique, HTTPS
DEBUG=True

# --- Sécurité ----------------------------------------------------------------
# Obligatoire. Génération : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Hôtes autorisés (séparés par des virgules) — obligatoire si DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Origines CSRF autorisées (HTTPS) — recommandé en production
CSRF_TRUSTED_ORIGINS=

# --- Base de données (uniquement si DEBUG=False) -----------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- HTTPS (production) ------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
USE_X_FORWARDED_PROTO=True

# --- Journalisation ----------------------------------------------------------
# LOG_LEVEL=INFO
